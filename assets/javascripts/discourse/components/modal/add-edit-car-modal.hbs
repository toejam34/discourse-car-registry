<DModal
  @title={{if @model.car (i18n "car_registry.modal.title_edit") (i18n "car_registry.modal.title_new")}}
  @closeModal={{@closeModal}}
  class="add-edit-car-modal"
>
  <:body>
    <div class="form-horizontal">
      <div class="control-group">
        <label>{{i18n "car_registry.modal.model_label"}}</label>
        <Input @type="text" @value={{this.carModel}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.colour_label"}}</label>
        <Input @type="text" @value={{this.colour}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.trim_label"}}</label>
        <Input @type="text" @value={{this.trim}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.location_label"}}</label>
        <Input @type="text" @value={{this.location}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.plaque_label"}}</label>
        <Input @type="text" @value={{this.plaqueNumber}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.reg_number_label"}}</label>
        <Input @type="text" @value={{this.regNumber}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.forum_name_label"}}</label>
        <Input @type="text" @value={{this.forumName}} class="input-large" />
      </div>

      <div class="control-group">
        <label>{{i18n "car_registry.modal.unique_info_label"}}</label>
        <Textarea @value={{this.uniqueInfo}} class="input-large" />
      </div>
    </div>
  </:body>

  <:footer>
    <DButton
      @action={{this.save}}
      @label="car_registry.modal.save_button"
      class="btn-primary"
    />
    <DButton
      @action={{@closeModal}}
      @label="cancel"
      class="btn-dismiss"
    />
  </:footer>
</DModal>
